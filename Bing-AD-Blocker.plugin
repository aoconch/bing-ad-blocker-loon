#!name = Bing 广告屏蔽
#!desc = 屏蔽 Microsoft Bing App 广告（v15：rewards.bing.com 完全不 MitM/不跑脚本；搜索仅白名单子域）
#!author = WorkBuddy
#!homepage = https://github.com/aoconch/bing-ad-blocker-loon
#!tag = 去广告, Bing
#!type = normal

# ============================================================
# 设计说明（v15 · 纯 JS、零 Rule）
# ------------------------------------------------------------
# ① bing_block_request.js —— http-request：只匹配广告/竞价/追踪域名
# ② bing_remove_ads.js —— http-response：剥内联广告
# v15（HAR #297）：设备仍 MitM rewards.bing.com 且命中「Bing去广告(搜索)」。
#   - MitM：-rewards.bing.com 必须写在 *.bing.com 之前（Loon 按序匹配）
#   - 搜索脚本：改为白名单子域（www/cn/www2…），不用负向前瞻（Loon 可能不支持）
#   - 不再 MitM / 脚本处理 rewardsplatform（Rewards 浏览彻底旁路）
# ============================================================

# ============================================================
# [Mitm]
# -rewards.bing.com 必须排在 *.bing.com 前面，否则排除无效。
# ============================================================
[Mitm]
hostname = -rewards.bing.com, bing.com, www.bing.com, cn.bing.com, www2.bing.com, r.bing.com, api.bing.com, th.bing.com, *.msn.com, *.msn.cn, msn.cn, assets.msn.com, assets.msn.cn, www.msn.com, www.msn.cn, srtb.msn.com, srtb.msn.cn, ads.msn.com, *.msads.net, msads.net, bingads.microsoft.com, booking.com, *.booking.com, bstatic.com, *.bstatic.com, ctrip.com, *.ctrip.com, trip.com, *.trip.com, doubleclick.net, *.doubleclick.net, googlesyndication.com, *.googlesyndication.com, googleadservices.com, *.googleadservices.com, adservice.google.com, adnxs.com, *.adnxs.com, rubiconproject.com, *.rubiconproject.com, pubmatic.com, *.pubmatic.com, criteo.com, *.criteo.com, criteo.net, *.criteo.net, moatads.com, *.moatads.com, spotx.tv, *.spotx.tv, openx.net, *.openx.net, scorecardresearch.com, *.scorecardresearch.com, taboola.com, *.taboola.com, outbrain.com, *.outbrain.com, adform.net, *.adform.net, adroll.com, *.adroll.com, advertising.com, *.advertising.com, adtechus.com, *.adtechus.com, adsrvr.org, *.adsrvr.org, bounceexchange.com, *.bounceexchange.com, rfihub.com, *.rfihub.com, crwdcntrl.net, *.crwdcntrl.net, adsystem.com, *.adsystem.com, adservice.com, *.adservice.com, analytics.adjust.io, *.analytics.adjust.io, analytics.adjust.com, *.analytics.adjust.com, self.events.data.microsoft.com, gateway.bingviz.microsoftapp.net, firebase-settings.crashlytics.com, firebaselogging-pa.googleapis.com, yidianzixun.com, *.yidianzixun.com, go2yd.com, doris.yidianzixun.com

# ============================================================
# [Script]  v2 语法（Loon 3.5.1 983+）
# ============================================================
[Script]
# ① 请求阶段：只拦截广告/竞价/追踪域名（禁止匹配全部 https://）
request if ${url} ~= /^https?:\/\/([^\/]*\.)?(srtb\.msn\.(com|cn)|msads\.net|ads\.msn\.com|bingads\.microsoft\.com|doubleclick\.net|googlesyndication\.com|googleadservices\.com|adservice\.google\.com|adnxs\.com|rubiconproject\.com|pubmatic\.com|criteo\.(com|net)|moatads\.com|spotx\.tv|openx\.net|scorecardresearch\.com|taboola\.com|outbrain\.com|adform\.net|adroll\.com|advertising\.com|adtechus\.com|adsrvr\.org|bounceexchange\.com|rfihub\.com|crwdcntrl\.net|adsystem\.com|adservice\.com|analytics\.adjust\.(io|com)|self\.events\.data\.microsoft\.com|gateway\.bingviz\.microsoftapp\.net|firebase-settings\.crashlytics\.com|firebaselogging-pa\.googleapis\.com|yidianzixun\.com|go2yd\.com|doris\.yidianzixun\.com|booking\.com|bstatic\.com|ctrip\.com|trip\.com)\//i then script("https://raw.githubusercontent.com/aoconch/bing-ad-blocker-loon/main/bing_block_request.js") with tag="Bing去广告(请求拦截)", timeout=5

# ①b MSN 域名下的广告 JS chunk（ads-utils 等）
request if ${url} ~= /^https?:\/\/([^\/]*\.)?msn\.(com|cn)\/.*?(ads-utils|libs_ads|DisplayAds|nativead|ad-plugin|xandr)/i then script("https://raw.githubusercontent.com/aoconch/bing-ad-blocker-loon/main/bing_block_request.js") with tag="Bing去广告(广告JS)", timeout=5

# ② 响应阶段：仅白名单 Bing 搜索子域（不含 rewards.bing.com）
response if ${url} ~= /^https?:\/\/(www\.|cn\.|www2\.|r\.|api\.|th\.)?bing\.com\//i then script("https://raw.githubusercontent.com/aoconch/bing-ad-blocker-loon/main/bing_remove_ads.js") with tag="Bing去广告(搜索)", timeout=20, requires_body=true

response if ${url} ~= /^https?:\/\/assets\.msn\.(com|cn)\/service\/(news|graph|MSN)\//i then script("https://raw.githubusercontent.com/aoconch/bing-ad-blocker-loon/main/bing_remove_ads.js") with tag="Bing去广告(信息流)", timeout=20, requires_body=true

response if ${url} ~= /^https?:\/\/(www\.|assets\.)?msn\.(com|cn)\/(resolver\/api\/resolve|pcs\/api)\//i then script("https://raw.githubusercontent.com/aoconch/bing-ad-blocker-loon/main/bing_remove_ads.js") with tag="Bing去广告(AppConfig)", timeout=20, requires_body=true

response if ${url} ~= /^https?:\/\/(www\.)?msn\.(com|cn)\/[a-z]{2}-[a-z]{2}\//i then script("https://raw.githubusercontent.com/aoconch/bing-ad-blocker-loon/main/bing_remove_ads.js") with tag="Bing去广告(MSN页)", timeout=20, requires_body=true

# ③ Rewards：完全旁路（不再 MitM / 不再跑响应脚本）
